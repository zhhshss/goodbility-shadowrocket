#!name=Oilcraft 视频净化
#!desc=Oilcraft（瓜子系换皮）视频 App 去广告：开屏/弹窗/横幅/播放页/评论区/悬浮广告 + 腾讯广告SDK
#!author=浮浮酱（基于 HAR 抓包分析）
#!note=广告接口加密且为 POST 请求，采用 http-response 返回空 JSON + 拦截腾讯广告SDK
#!updated=2026-09-19 v2

[Script]
# 广告接口返回空 JSON（覆盖 POST/GET）
oilcraft_ad_0 = type=http-response,pattern=^https:\/\/(api|sdapi|newapi|hyperf|oldapi)\.[a-z0-9]+\.com\/App\/Ad\/activityInfo$,script-path=https://raw.githubusercontent.com/zhhshss/goodbility-shadowrocket/main/empty_json.js,requires-body=true
